weights/
*.pt
*.pth
*.onnx
*.engine
*.npz
*.npy

# ---- Pipeline / training outputs ----
# NOTE: keep comments on their own line — gitignore does not support inline
# (trailing) comments; a "dir/  # note" line would be treated as a literal path.
# pipeline work_dirs
runs/
# detector training runs
phase1/runs/
# symlinked YOLO dataset (regenerated by `prepare`)
phase1/dataset/
# generated result artifacts (logs, reports, caches, media)
phase2_results/
*.log
*.cache

